# Copy to apps/api/.env and fill in.

# PayPal Sandbox (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI (Groq). If the key is missing or Groq fails, a rule-based planner takes over
# and every request is routed to human review.
# Check console.groq.com for models that are deprecated or no longer served.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Reads photos of invoices (PDFs don't need it). Must be a Groq model that accepts images.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Runs the AG Studio assistant on the Insights page (needs strong tool calling).
GROQ_STUDIO_MODEL=openai/gpt-oss-120b

# Where PayPal sends the payer back to after Checkout
FRONTEND_URL=http://localhost:3000
# Extra allowed browser origins, comma separated (e.g. a deployed web URL)
CORS_ORIGINS=

# Optional: a sandbox PERSONAL account email (developer.paypal.com > Sandbox Accounts).
# Demo payees get this email when the database is created, so payouts show as delivered.
DEMO_PAYEE_EMAIL=

# Name shown on invoices and receipts
BUSINESS_NAME=PayPilot Demo Business

# Optional: SQLite file location (default: apps/api/data/paypilot.db)
# PAYPILOT_DB_PATH=

# ---- Web (apps/web/.env.local, not apps/api/.env) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# AG Studio licence key for the Insights page. Optional: without it Studio shows a trial watermark.
# NEXT_PUBLIC_AG_STUDIO_LICENSE=
