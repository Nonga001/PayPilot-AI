# Copy to apps/api/.env and fill in.

# PayPal Sandbox (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI (Groq). If the key is missing or Groq fails, a rule-based parser takes over
# and every request is routed to human review.
# Check console.groq.com for models that are deprecated or no longer served.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Where PayPal sends the payer back to
FRONTEND_URL=http://localhost:3000

# Optional: SQLite file location (default: apps/api/data/paypilot.db)
# PAYPILOT_DB_PATH=
